---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import FaviconLookup from '../../../components/FaviconLookup.astro';
import Icon from '../../../components/Icon.astro';
import { LOCALES, LOCALE_CODES, DEFAULT_LOCALE, absoluteUrl, fmt, formatDate, localizePath, useTranslations, type Locale } from '../../../i18n';
import { getGuides, readingMinutes, type Guide } from '../../../lib/content';
import { SITE_URL } from '../../../site.config';

export async function getStaticPaths() {
	const paths = [];
	for (const locale of LOCALE_CODES) {
		const guides = await getGuides(locale);
		for (const guide of guides) {
			paths.push({
				params: { lang: locale === DEFAULT_LOCALE ? undefined : locale, slug: guide.slug },
				props: { locale, guide, guides },
			});
		}
	}
	return paths;
}

const { locale, guide, guides } = Astro.props as { locale: Locale; guide: Guide; guides: Guide[] };
const t = useTranslations(locale);
const { Content, headings } = await render(guide);
const toc = headings.filter((heading) => heading.depth === 2);
const path = `/guides/${guide.slug}/`;
const url = absoluteUrl(localizePath(locale, path));
const related = guides.filter((item) => item.slug !== guide.slug).slice(0, 3);
const minutes = readingMinutes(guide.body ?? '');
const breadcrumbs = [
	{ name: t.nav.guides, path: '/guides/' },
	{ name: guide.data.title, path },
];
const article = {
	'@type': 'TechArticle',
	'@id': `${url}#article`,
	headline: guide.data.title,
	description: guide.data.description,
	inLanguage: LOCALES[locale].htmlLang,
	url,
	mainEntityOfPage: { '@id': `${url}#webpage` },
	datePublished: '2026-11-22',
	dateModified: guide.data.updated.toISOString().slice(0, 10),
	author: { '@id': `${SITE_URL}/#organization` },
	publisher: { '@id': `${SITE_URL}/#organization` },
	image: absoluteUrl('/og-image.png'),
	timeRequired: `PT${minutes}M`,
};
---

<BaseLayout locale={locale} title={`${guide.data.title} | Favicon.is`} description={guide.data.description} path={path} ogType="article" breadcrumbs={breadcrumbs} jsonLd={[article]}>
	<div class="container-page grid gap-12 py-10 lg:grid-cols-[minmax(0,1fr)_16rem]">
		<article class="min-w-0">
			<Breadcrumbs locale={locale} items={breadcrumbs} />
			<header class="mt-8 border-b border-slate-200 pb-8 dark:border-white/10">
				<h1 class="text-3xl font-extrabold tracking-tight sm:text-5xl">{guide.data.title}</h1>
				<p class="mt-4 text-lg leading-relaxed text-slate-600 dark:text-slate-400">{guide.data.description}</p>
				<p class="mt-5 flex flex-wrap items-center gap-3 text-sm text-slate-500 dark:text-slate-400">
					<span class="inline-flex items-center gap-1.5"><Icon name="clock" class="size-4" />{fmt(t.common.minutesRead, { n: minutes })}</span>
					<span>·</span>
					<time datetime={guide.data.updated.toISOString().slice(0, 10)}>{fmt(t.common.updated, { date: formatDate(guide.data.updated, locale) })}</time>
				</p>
			</header>
			<div class="prose-site mt-8">
				<Content />
			</div>

			<div class="card mt-12 p-6 sm:p-8">
				<h2 class="flex items-center gap-2 text-lg font-semibold"><Icon name="scan" class="size-5 text-brand-500" />{t.guides.cta}</h2>
				<a href={localizePath(locale, '/checker/')} class="btn-brand mt-4">{t.nav.checker}<Icon name="arrowRight" class="size-4" /></a>
			</div>

			{
				related.length > 0 && (
					<section class="mt-12">
						<h2 class="text-xl font-bold tracking-tight">{t.guides.related}</h2>
						<div class="mt-5 grid gap-4 sm:grid-cols-3">
							{related.map((item) => (
								<a href={localizePath(locale, `/guides/${item.slug}/`)} class="card p-5 transition hover:border-brand-200 dark:hover:border-brand-500/30">
									<h3 class="font-semibold">{item.data.title}</h3>
									<p class="mt-2 line-clamp-3 text-sm text-slate-600 dark:text-slate-400">{item.data.description}</p>
								</a>
							))}
						</div>
					</section>
				)
			}
		</article>

		<aside class="hidden lg:block">
			<div class="sticky top-24 space-y-8">
				{
					toc.length > 0 && (
						<nav aria-label={t.common.onThisPage}>
							<p class="text-xs font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-400">{t.common.onThisPage}</p>
							<ul class="mt-3 space-y-1 border-l border-slate-200 text-sm dark:border-white/10">
								{toc.map((heading) => (
									<li>
										<a href={`#${heading.slug}`} class="-ml-px block border-l border-transparent py-1 pl-4 text-slate-600 hover:border-slate-400 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white">
											{heading.text}
										</a>
									</li>
								))}
							</ul>
						</nav>
					)
				}
				<div class="card p-4">
					<p class="mb-3 text-sm font-semibold text-slate-900 dark:text-white">{t.site.otherSite}</p>
					<FaviconLookup locale={locale} mode="navigate" size="md" />
				</div>
			</div>
		</aside>
	</div>
</BaseLayout>
