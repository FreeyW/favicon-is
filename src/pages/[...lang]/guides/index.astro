---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Icon from '../../../components/Icon.astro';
import { LOCALES, absoluteUrl, fmt, formatDate, localeStaticPaths, localizePath, useTranslations, type Locale } from '../../../i18n';
import { getGuides, readingMinutes } from '../../../lib/content';

export function getStaticPaths() {
	return localeStaticPaths();
}

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const g = t.guides;
const guides = await getGuides(locale);
const list = {
	'@type': 'CollectionPage',
	name: g.title,
	description: g.metaDescription,
	inLanguage: LOCALES[locale].htmlLang,
	url: absoluteUrl(localizePath(locale, '/guides/')),
	mainEntity: {
		'@type': 'ItemList',
		itemListElement: guides.map((guide, index) => ({
			'@type': 'ListItem',
			position: index + 1,
			name: guide.data.title,
			url: absoluteUrl(localizePath(locale, `/guides/${guide.slug}/`)),
		})),
	},
};
---

<BaseLayout locale={locale} title={g.metaTitle} description={g.metaDescription} path="/guides/" breadcrumbs={[{ name: t.nav.guides, path: '/guides/' }]} jsonLd={[list]}>
	<PageHeader locale={locale} title={g.title} intro={g.intro} breadcrumbs={[{ name: t.nav.guides, path: '/guides/' }]} />
	<div class="container-page py-12">
		<div class="grid gap-5 md:grid-cols-2">
			{
				guides.map((guide, index) => (
					<a
						href={localizePath(locale, `/guides/${guide.slug}/`)}
						class:list={['card group flex flex-col p-6 transition hover:-translate-y-0.5 hover:border-brand-200 hover:shadow-md sm:p-8 dark:hover:border-brand-500/30', index === 0 && 'md:col-span-2']}
					>
						<p class="flex items-center gap-3 text-xs text-slate-500 dark:text-slate-400">
							<span class="font-mono font-semibold text-brand-600 dark:text-brand-400">0{index + 1}</span>
							<span>{fmt(t.common.minutesRead, { n: readingMinutes(guide.body ?? '') })}</span>
							<span>·</span>
							<time datetime={guide.data.updated.toISOString().slice(0, 10)}>{formatDate(guide.data.updated, locale)}</time>
						</p>
						<h2 class="mt-3 text-xl font-bold tracking-tight group-hover:text-brand-700 sm:text-2xl dark:group-hover:text-brand-300">{guide.data.title}</h2>
						<p class="mt-3 flex-1 leading-relaxed text-slate-600 dark:text-slate-400">{guide.data.description}</p>
						<span class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-brand-600 dark:text-brand-400">
							{t.common.readMore}
							<Icon name="arrowRight" class="size-3.5" />
						</span>
					</a>
				))
			}
		</div>
	</div>
</BaseLayout>
