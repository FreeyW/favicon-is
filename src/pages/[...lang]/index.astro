---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaviconLookup from '../../components/FaviconLookup.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import FaqList from '../../components/FaqList.astro';
import SiteTile from '../../components/SiteTile.astro';
import Icon, { type IconName } from '../../components/Icon.astro';
import { LOCALES, LOCALE_CODES, absoluteUrl, formatNumber, localeStaticPaths, localizePath, useTranslations, type Locale } from '../../i18n';
import { FEATURED_DOMAINS, POPULAR_CATEGORIES } from '../../data/popular';
import { TLD_DATA } from '../../lib/tlds';
import { getGuides } from '../../lib/content';
import { SITE_NAME, SITE_URL } from '../../site.config';

export function getStaticPaths() {
	return localeStaticPaths();
}

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const l = (path: string) => localizePath(locale, path);
const guides = (await getGuides(locale)).slice(0, 3);

const featureIcons: IconName[] = ['zap', 'image', 'layers', 'key', 'database', 'shield'];
const stats = [
	{ value: formatNumber(TLD_DATA.count, locale), label: t.home.stats.tlds },
	{ value: '6', label: t.home.stats.sizes },
	{ value: String(LOCALE_CODES.length), label: t.home.stats.languages },
	{ value: '0', label: t.home.stats.apiKey },
];
const usage = [
	{ url: `${SITE_URL}/github.com`, label: t.home.usage.basic, preview: '/github.com' },
	{ url: `${SITE_URL}/github.com?larger=true`, label: t.home.usage.larger, preview: '/github.com?larger=true' },
	{ url: `${SITE_URL}/github.com?size=32`, label: t.home.usage.size, preview: '/github.com?size=32' },
	{ url: `${SITE_URL}/github.com?original=true`, label: t.home.usage.original, preview: '/github.com?original=true' },
];
const rowA = FEATURED_DOMAINS.slice(0, 12);
const rowB = FEATURED_DOMAINS.slice(12);
const popular = [
	...POPULAR_CATEGORIES.search.slice(0, 2),
	...POPULAR_CATEGORIES.social.slice(0, 2),
	...POPULAR_CATEGORIES.video.slice(0, 2),
	...POPULAR_CATEGORIES.developer.slice(0, 2),
	...POPULAR_CATEGORIES.shopping.slice(0, 2),
	...POPULAR_CATEGORIES.news.slice(0, 2),
];
const tryDomains = ['github.com', 'wikipedia.org', 'stripe.com', 'figma.com'];

const app = {
	'@type': 'WebApplication',
	'@id': `${SITE_URL}/#app`,
	name: SITE_NAME,
	url: absoluteUrl(l('/')),
	description: t.home.metaDescription,
	applicationCategory: 'DeveloperApplication',
	operatingSystem: 'Any',
	browserRequirements: 'Requires a web browser or HTTP client',
	isAccessibleForFree: true,
	inLanguage: LOCALES[locale].htmlLang,
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
	publisher: { '@id': `${SITE_URL}/#organization` },
};
---

<BaseLayout locale={locale} title={t.home.metaTitle} description={t.home.metaDescription} path="/" jsonLd={[app]}>
	<!-- Hero -->
	<section class="relative overflow-hidden">
		<div class="bg-grid pointer-events-none absolute inset-0 [mask-image:radial-gradient(ellipse_at_top,black_35%,transparent_75%)]"></div>
		<div class="pointer-events-none absolute -top-48 left-1/2 h-[34rem] w-[60rem] -translate-x-1/2 rounded-full bg-gradient-to-tr from-brand-400/30 via-sky-300/20 to-violet-400/25 blur-3xl dark:from-brand-500/20 dark:via-sky-500/10 dark:to-violet-500/20"></div>
		<div class="container-page relative pt-16 pb-14 text-center sm:pt-24 sm:pb-20">
			<p class="chip mx-auto px-3 py-1 text-sm">
				<Icon name="sparkles" class="size-4 text-brand-500" />
				{t.home.badge}
			</p>
			<h1 class="mx-auto mt-6 max-w-4xl text-4xl font-extrabold tracking-tight sm:text-6xl">
				{t.home.heroTitle}
				<span class="block bg-gradient-to-r from-brand-600 via-sky-500 to-violet-500 bg-clip-text pb-1 text-transparent dark:from-brand-400 dark:via-sky-300 dark:to-violet-400">
					{t.home.heroHighlight}
				</span>
			</h1>
			<p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-slate-600 sm:text-xl dark:text-slate-400">{t.home.heroSubtitle}</p>
			<div class="mx-auto mt-10 max-w-3xl">
				<FaviconLookup locale={locale} mode="inline" />
				<p class="mt-4 flex flex-wrap items-center justify-center gap-2 text-sm text-slate-500 dark:text-slate-400">
					<span>{t.common.tryIt}:</span>
					{
						tryDomains.map((domain) => (
							<a href={`${l('/')}?q=${domain}`} class="chip gap-2 py-1 hover:border-brand-300 hover:text-slate-900 dark:hover:text-white">
								<img src={`/${domain}?size=32`} alt="" width="14" height="14" class="size-3.5" />
								{domain}
							</a>
						))
					}
				</p>
			</div>
		</div>

		<!-- Marquee of live icons -->
		<div class="relative space-y-4 pb-16 [mask-image:linear-gradient(to_right,transparent,black_12%,black_88%,transparent)]" aria-hidden="true">
			{
				[rowA, rowB].map((row, index) => (
					<div class="flex w-max animate-marquee gap-4 hover:[animation-play-state:paused]" style={index === 1 ? 'animation-direction: reverse; animation-duration: 70s' : undefined}>
						{[...row, ...row].map((domain) => (
							<a href={l(`/site/${domain}/`)} tabindex="-1" class="icon-tile size-16 transition hover:-translate-y-1 hover:shadow-md">
								<img src={`/${domain}?size=64`} alt="" width="32" height="32" class="size-8" loading="lazy" decoding="async" />
							</a>
						))}
					</div>
				))
			}
		</div>
	</section>

	<!-- Stats -->
	<section class="border-y border-slate-200/70 bg-slate-50/60 dark:border-white/10 dark:bg-white/[0.02]">
		<dl class="container-page grid grid-cols-2 gap-6 py-10 sm:grid-cols-4">
			{
				stats.map((stat) => (
					<div class="text-center">
						<dt class="text-sm text-slate-500 dark:text-slate-400">{stat.label}</dt>
						<dd class="mt-1 text-3xl font-bold tracking-tight text-slate-900 dark:text-white">{stat.value}</dd>
					</div>
				))
			}
		</dl>
	</section>

	<!-- Features -->
	<section class="container-page py-20 sm:py-24">
		<div class="mx-auto max-w-2xl text-center">
			<h2 class="section-title">{t.home.featuresTitle}</h2>
			<p class="section-subtitle">{t.home.featuresSubtitle}</p>
		</div>
		<div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
			{
				t.home.features.map((feature, index) => (
					<div class="card group relative p-6 transition hover:border-brand-200 dark:hover:border-brand-500/30">
						<span class="flex size-11 items-center justify-center rounded-xl bg-gradient-to-br from-brand-500 to-violet-500 text-white shadow-lg shadow-brand-500/20">
							<Icon name={featureIcons[index] ?? 'sparkles'} class="size-5" />
						</span>
						<h3 class="mt-5 text-lg font-semibold">{feature.title}</h3>
						<p class="mt-2 leading-relaxed text-slate-600 dark:text-slate-400">{feature.description}</p>
					</div>
				))
			}
		</div>
	</section>

	<!-- How it works -->
	<section class="relative overflow-hidden bg-slate-950 py-20 text-slate-300 sm:py-24">
		<div class="pointer-events-none absolute inset-0 opacity-40 bg-grid [mask-image:radial-gradient(ellipse_at_center,black,transparent_70%)]"></div>
		<div class="container-page relative">
			<div class="mx-auto max-w-2xl text-center">
				<h2 class="section-title text-white">{t.home.howTitle}</h2>
				<p class="mt-3 text-lg text-slate-400">{t.home.howSubtitle}</p>
			</div>
			<ol class="mt-14 grid gap-5 md:grid-cols-4">
				{
					t.home.steps.map((step, index) => (
						<li class="relative rounded-2xl border border-white/10 bg-white/[0.03] p-6">
							<span class="font-mono text-sm font-semibold text-brand-400">0{index + 1}</span>
							<h3 class="mt-3 text-lg font-semibold text-white">{step.title}</h3>
							<p class="mt-2 text-sm leading-relaxed text-slate-400">{step.description}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<!-- Usage -->
	<section class="container-page py-20 sm:py-24">
		<div class="grid items-start gap-12 lg:grid-cols-5">
			<div class="lg:col-span-2">
				<h2 class="section-title">{t.home.usageTitle}</h2>
				<p class="section-subtitle">{t.home.usageSubtitle}</p>
				<div class="mt-8 flex flex-wrap gap-3">
					<a href={l('/docs/')} class="btn-primary">
						<Icon name="book" class="size-4" />
						{t.nav.docs}
					</a>
					<a href={l('/examples/')} class="btn-ghost">
						<Icon name="code" class="size-4" />
						{t.nav.examples}
					</a>
				</div>
			</div>
			<div class="space-y-3 lg:col-span-3">
				{
					usage.map((item) => (
						<div class="card flex items-center gap-4 p-3 pr-4">
							<span class="icon-tile size-12 shrink-0">
								<img src={item.preview} alt="" width="28" height="28" class="size-7" loading="lazy" />
							</span>
							<div class="min-w-0 flex-1">
								<p class="text-sm font-medium text-slate-900 dark:text-white">{item.label}</p>
								<code class="mt-0.5 block truncate font-mono text-[13px] text-brand-700 dark:text-brand-300">{item.url}</code>
							</div>
							<button
								type="button"
								class="rounded-lg p-2 text-slate-400 hover:bg-slate-100 hover:text-slate-900 dark:hover:bg-white/10 dark:hover:text-white"
								data-copy={item.url}
								data-copied-label="✓"
								aria-label={t.common.copy}
								title={t.common.copy}
							>
								<span data-copy-label class="sr-only">{t.common.copy}</span>
								<Icon name="copy" class="size-4" />
							</button>
						</div>
					))
				}
				<CodeBlock
					code={`<img src="https://favicon.is/github.com" width="32" height="32" alt="GitHub">`}
					lang="html"
					title={t.common.html}
					copyLabel={t.common.copy}
					copiedLabel={t.common.copied}
				/>
			</div>
		</div>
	</section>

	<!-- Popular -->
	<section class="border-t border-slate-200/70 bg-slate-50/60 py-20 sm:py-24 dark:border-white/10 dark:bg-white/[0.02]">
		<div class="container-page">
			<div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
				<div>
					<h2 class="section-title">{t.home.popularTitle}</h2>
					<p class="section-subtitle">{t.home.popularSubtitle}</p>
				</div>
				<a href={l('/popular/')} class="btn-ghost shrink-0">
					{t.common.viewAll}
					<Icon name="arrowRight" class="size-4" />
				</a>
			</div>
			<div class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
				{popular.map((domain) => <SiteTile locale={locale} domain={domain} />)}
			</div>
		</div>
	</section>

	<!-- Guides -->
	<section class="container-page py-20 sm:py-24">
		<div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
			<div>
				<h2 class="section-title">{t.home.guidesTitle}</h2>
				<p class="section-subtitle">{t.home.guidesSubtitle}</p>
			</div>
			<a href={l('/guides/')} class="btn-ghost shrink-0">
				{t.common.viewAll}
				<Icon name="arrowRight" class="size-4" />
			</a>
		</div>
		<div class="mt-10 grid gap-5 md:grid-cols-3">
			{
				guides.map((guide) => (
					<a href={l(`/guides/${guide.slug}/`)} class="card group flex flex-col p-6 transition hover:-translate-y-0.5 hover:border-brand-200 hover:shadow-md dark:hover:border-brand-500/30">
						<Icon name="book" class="size-5 text-brand-500" />
						<h3 class="mt-4 text-lg font-semibold group-hover:text-brand-700 dark:group-hover:text-brand-300">{guide.data.title}</h3>
						<p class="mt-2 line-clamp-3 flex-1 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{guide.data.description}</p>
						<span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-brand-600 dark:text-brand-400">
							{t.common.readMore}
							<Icon name="arrowRight" class="size-3.5" />
						</span>
					</a>
				))
			}
		</div>
	</section>

	<!-- FAQ -->
	<section class="container-page pb-20 sm:pb-24">
		<div class="grid gap-10 lg:grid-cols-3">
			<div>
				<h2 class="section-title">{t.home.faqTitle}</h2>
				<a href={l('/faq/')} class="mt-6 inline-flex items-center gap-1 font-medium text-brand-600 hover:underline dark:text-brand-400">
					{t.home.faqMore}
					<Icon name="arrowRight" class="size-4" />
				</a>
			</div>
			<div class="lg:col-span-2">
				<FaqList items={t.faq.items.slice(0, 6)} />
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="container-page">
		<div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-brand-600 via-sky-600 to-violet-600 px-6 py-14 text-center shadow-2xl shadow-brand-600/20 sm:px-12">
			<div class="bg-grid pointer-events-none absolute inset-0 opacity-30 [mask-image:radial-gradient(ellipse_at_center,black,transparent_70%)]"></div>
			<h2 class="relative text-3xl font-bold tracking-tight text-white sm:text-4xl">{t.home.ctaTitle}</h2>
			<p class="relative mx-auto mt-4 max-w-xl text-lg text-white/80">{t.home.ctaSubtitle}</p>
			<div class="relative mt-8 flex flex-wrap justify-center gap-3">
				<a href={l('/docs/')} class="btn bg-white text-slate-900 shadow-lg hover:bg-slate-100">{t.home.ctaPrimary}</a>
				<a href={l('/examples/')} class="btn border border-white/30 bg-white/10 text-white hover:bg-white/20">{t.home.ctaSecondary}</a>
			</div>
		</div>
	</section>
</BaseLayout>
