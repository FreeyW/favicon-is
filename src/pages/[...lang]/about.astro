---
import LegalPage from '../../components/LegalPage.astro';
import { localeStaticPaths, useTranslations, type Locale } from '../../i18n';

export function getStaticPaths() {
	return localeStaticPaths();
}

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
---

<LegalPage locale={locale} slug="about" navLabel={t.nav.about} />
