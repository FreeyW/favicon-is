---
/** Syntax-highlighted code (build-time Shiki) with a copy button. Use in prerendered pages only. */
import { Code } from 'astro:components';
import Icon from './Icon.astro';

interface Props {
	code: string;
	lang?: string;
	title?: string;
	copyLabel: string;
	copiedLabel: string;
	class?: string;
}

const { code, lang = 'plaintext', title, copyLabel, copiedLabel, class: className } = Astro.props;
---

<div class:list={['overflow-hidden rounded-xl border border-slate-200 bg-slate-50 dark:border-white/10 dark:bg-slate-900', className]}>
	<div class="flex items-center justify-between gap-3 border-b border-slate-200 px-4 py-2 dark:border-white/10">
		<span class="text-xs font-medium text-slate-500 dark:text-slate-400">{title ?? lang}</span>
		<button
			type="button"
			class="inline-flex items-center gap-1.5 rounded-md px-2 py-1 text-xs font-medium text-slate-500 transition hover:bg-slate-200/70 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-white/10 dark:hover:text-white"
			data-copy={code}
			data-copied-label={copiedLabel}
		>
			<Icon name="copy" class="size-3.5" />
			<span data-copy-label>{copyLabel}</span>
		</button>
	</div>
	<Code code={code} lang={lang as any} themes={{ light: 'github-light', dark: 'github-dark' }} />
</div>
