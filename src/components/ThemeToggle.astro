---
import Icon from './Icon.astro';

interface Props {
	label: string;
}
const { label } = Astro.props;
---

<button
	type="button"
	data-theme-toggle
	class="flex size-10 items-center justify-center rounded-lg text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-white/10 dark:hover:text-white"
	aria-label={label}
	title={label}
>
	<Icon name="moon" class="size-[18px] dark:hidden" />
	<Icon name="sun" class="hidden size-[18px] dark:block" />
</button>

<script>
	document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
		button.addEventListener('click', () => {
			const dark = document.documentElement.classList.toggle('dark');
			try {
				localStorage.setItem('theme', dark ? 'dark' : 'light');
			} catch {
				// storage unavailable
			}
		});
	});
</script>
