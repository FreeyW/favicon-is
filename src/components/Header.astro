---
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import { localizePath, useTranslations, type Locale } from '../i18n';

interface Props {
	locale: Locale;
	path: string;
}

const { locale, path } = Astro.props;
const t = useTranslations(locale);
const links = [
	{ href: '/docs/', label: t.nav.docs },
	{ href: '/examples/', label: t.nav.examples },
	{ href: '/checker/', label: t.nav.checker },
	{ href: '/popular/', label: t.nav.popular },
	{ href: '/guides/', label: t.nav.guides },
];
const mobileLinks = [...links, { href: '/tlds/', label: t.nav.tlds }, { href: '/faq/', label: t.nav.faq }, { href: '/about/', label: t.nav.about }];
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/80 backdrop-blur-xl dark:border-white/10 dark:bg-slate-950/75">
	<div class="container-page flex h-16 items-center gap-4">
		<a href={localizePath(locale, '/')} class="flex shrink-0 items-center gap-2.5 font-bold text-slate-900 dark:text-white" aria-label="Favicon.is">
			<img src="/favicon.png" alt="" width="32" height="32" class="size-8 rounded-lg" />
			<span class="text-lg tracking-tight">Favicon<span class="text-brand-600 dark:text-brand-400">.is</span></span>
		</a>

		<nav class="ml-4 hidden items-center gap-1 lg:flex" aria-label="Main">
			{
				links.map((link) => (
					<a
						href={localizePath(locale, link.href)}
						class:list={[
							'rounded-lg px-3 py-2 text-sm font-medium transition',
							isActive(link.href)
								? 'bg-slate-100 text-slate-900 dark:bg-white/10 dark:text-white'
								: 'text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-white/5 dark:hover:text-white',
						]}
						aria-current={isActive(link.href) ? 'page' : undefined}
					>
						{link.label}
					</a>
				))
			}
		</nav>

		<div class="ml-auto flex items-center gap-1.5">
			<LanguageSwitcher locale={locale} path={path} />
			<ThemeToggle label={t.nav.toggleTheme} />
			<a href={localizePath(locale, '/docs/')} class="btn-primary ml-1 hidden px-3.5 py-2 sm:inline-flex">
				{t.nav.getStarted}
				<Icon name="arrowRight" class="size-4" />
			</a>
			<details class="group relative lg:hidden" data-dismissable>
				<summary class="flex size-10 cursor-pointer list-none items-center justify-center rounded-lg text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-white/10" aria-label={t.nav.menu}>
					<Icon name="menu" class="size-5 group-open:hidden" />
					<Icon name="x" class="hidden size-5 group-open:block" />
				</summary>
				<nav class="card absolute right-0 mt-2 w-64 p-2" aria-label={t.nav.menu}>
					{
						mobileLinks.map((link) => (
							<a
								href={localizePath(locale, link.href)}
								class:list={[
									'block rounded-lg px-3 py-2 text-sm font-medium',
									isActive(link.href) ? 'bg-slate-100 text-slate-900 dark:bg-white/10 dark:text-white' : 'text-slate-700 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-white/5',
								]}
							>
								{link.label}
							</a>
						))
					}
				</nav>
			</details>
		</div>
	</div>
</header>

<script>
	// Close open <details> menus when clicking outside or pressing Escape.
	const close = (except?: Element | null) => {
		document.querySelectorAll<HTMLDetailsElement>('details[data-dismissable][open]').forEach((el) => {
			if (el !== except) el.open = false;
		});
	};
	document.addEventListener('click', (event) => close((event.target as Element | null)?.closest('details[data-dismissable]')));
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') close();
	});
</script>
