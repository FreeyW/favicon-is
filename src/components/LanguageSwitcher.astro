---
import Icon from './Icon.astro';
import { LOCALES, LOCALE_CODES, localizePath, useTranslations, type Locale } from '../i18n';

interface Props {
	locale: Locale;
	path: string;
}

const { locale, path } = Astro.props;
const t = useTranslations(locale);
---

<details class="group relative" data-dismissable>
	<summary
		class="flex h-10 cursor-pointer list-none items-center gap-1.5 rounded-lg px-2.5 text-sm font-medium text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-white/10 dark:hover:text-white"
		aria-label={`${t.nav.language}: ${LOCALES[locale].name}`}
	>
		<Icon name="globe" class="size-[18px]" />
		<span class="hidden sm:inline">{LOCALES[locale].name}</span>
		<Icon name="chevronDown" class="size-3.5 transition group-open:rotate-180" />
	</summary>
	<div class="card absolute right-0 z-50 mt-2 max-h-[70vh] w-56 overflow-y-auto p-1.5">
		<p class="px-2.5 pt-1.5 pb-2 text-xs font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-400">{t.nav.language}</p>
		<ul>
			{
				LOCALE_CODES.map((code) => (
					<li>
						<a
							href={localizePath(code, path)}
							hreflang={LOCALES[code].hreflang}
							lang={LOCALES[code].htmlLang}
							class:list={[
								'flex items-center justify-between rounded-lg px-2.5 py-1.5 text-sm',
								code === locale ? 'bg-brand-50 font-semibold text-brand-700 dark:bg-brand-500/15 dark:text-brand-300' : 'text-slate-700 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-white/5',
							]}
							aria-current={code === locale ? 'true' : undefined}
						>
							<span>{LOCALES[code].name}</span>
							{code === locale && <Icon name="check" class="size-4" />}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</details>
