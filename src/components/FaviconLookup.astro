---
/**
 * Domain lookup widget.
 * - mode "inline": shows previews, the icon source and embed code in place (home page).
 * - mode "navigate": goes to the domain's favicon page (/site/{domain}/).
 * Works without JavaScript: the form falls back to GET /site/?domain=…
 */
import Icon from './Icon.astro';
import { localizePath, useTranslations, type Locale } from '../i18n';
import { SITE_URL } from '../site.config';

interface Props {
	locale: Locale;
	mode?: 'inline' | 'navigate';
	initial?: string;
	size?: 'lg' | 'md';
}

const { locale, mode = 'inline', initial = '', size = 'lg' } = Astro.props;
const t = useTranslations(locale);
const sizes = [16, 32, 48, 64, 128, 256];
const messages = {
	invalid: t.common.invalidDomain,
	unsupported: t.common.unsupportedTld,
	notFound: t.common.notFound,
	failed: t.common.failedToLoad,
	sources: t.common.sources,
	servedFrom: t.common.servedFrom,
};
const sitePath = localizePath(locale, '/site/{domain}/');
---

<div data-lookup data-mode={mode} data-site-path={sitePath} data-base={SITE_URL} data-i18n={JSON.stringify(messages)} class="w-full">
	<form action={localizePath(locale, '/site/')} method="get" class="relative" novalidate>
		<label for={`lookup-${mode}`} class="sr-only">{t.common.inputLabel}</label>
		<div
			class:list={[
				'flex items-center gap-2 rounded-2xl border border-slate-200 bg-white p-2 shadow-xl shadow-slate-900/5 transition focus-within:border-brand-400 focus-within:ring-4 focus-within:ring-brand-500/15 dark:border-white/10 dark:bg-slate-900 dark:shadow-black/20',
				size === 'lg' ? 'sm:p-2.5' : '',
			]}
		>
			<Icon name="search" class:list={['ml-2 size-5 shrink-0 text-slate-400', size === 'md' && 'hidden']} />
			{size === 'lg' && <span class="hidden shrink-0 font-mono text-sm text-slate-400 sm:inline dark:text-slate-500" aria-hidden="true">favicon.is/</span>}
			<input
				id={`lookup-${mode}`}
				name="domain"
				type="text"
				value={initial}
				placeholder={t.common.inputPlaceholder}
				autocomplete="off"
				autocapitalize="off"
				autocorrect="off"
				spellcheck="false"
				inputmode="url"
				enterkeyhint="go"
				required
				class:list={['min-w-0 flex-1 bg-transparent font-medium text-slate-900 outline-none placeholder:font-normal placeholder:text-slate-400 dark:text-white', size === 'lg' ? 'py-2 text-base sm:text-lg' : 'py-1.5 text-base']}
			/>
			<button type="submit" class:list={['btn-brand shrink-0', size === 'lg' ? 'sm:px-5 sm:py-3 sm:text-base' : 'px-3']} title={t.common.getIcon}>
				<span class:list={[size === 'md' && 'sr-only']}>{t.common.getIcon}</span>
				<Icon name="arrowRight" class:list={['size-4', size === 'lg' && 'hidden sm:block']} />
			</button>
		</div>
		<p data-error class="mt-3 hidden items-start gap-2 text-left text-sm text-rose-600 dark:text-rose-400" role="alert">
			<Icon name="info" class="mt-0.5 size-4 shrink-0" />
			<span data-error-text></span>
		</p>
	</form>

	{
		mode === 'inline' && (
			<div data-result class="card mt-6 hidden p-5 text-left sm:p-6" aria-live="polite">
				<div class="flex flex-col gap-6 md:flex-row">
					<div class="flex items-center gap-4 md:w-56 md:shrink-0 md:flex-col md:items-start">
						<div class="icon-tile size-24 shrink-0 sm:size-28">
							<img data-main alt="" width="64" height="64" class="size-16 opacity-0 transition-opacity" />
						</div>
						<div class="min-w-0">
							<p class="truncate text-lg font-semibold text-slate-900 dark:text-white" data-domain />
							<p class="mt-2 inline-flex items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400">
								<span class="size-2 rounded-full bg-slate-300" data-dot />
								<span data-source>{t.common.loading}</span>
							</p>
							<a data-site-link href="#" class="mt-3 flex items-center gap-1 text-sm font-medium text-brand-600 hover:underline dark:text-brand-400">
								{t.checker.viewPage}
								<Icon name="arrowRight" class="size-3.5" />
							</a>
						</div>
					</div>
					<div class="min-w-0 flex-1">
						<p class="text-sm font-semibold text-slate-900 dark:text-white">{t.home.sizesLabel}</p>
						<div class="mt-2 grid grid-cols-3 gap-2 sm:grid-cols-6" role="radiogroup" aria-label={t.home.sizesLabel}>
							{sizes.map((px) => (
								<button
									type="button"
									role="radio"
									aria-checked={px === 128 ? 'true' : 'false'}
									data-size={px}
									class="group flex flex-col items-center justify-end gap-1.5 rounded-xl border border-slate-200 bg-slate-50 p-2 pt-3 text-xs font-medium text-slate-500 transition hover:border-brand-300 aria-checked:border-brand-500 aria-checked:bg-brand-50 aria-checked:text-brand-700 dark:border-white/10 dark:bg-white/5 dark:text-slate-400 dark:aria-checked:border-brand-400 dark:aria-checked:bg-brand-500/10 dark:aria-checked:text-brand-300"
								>
									<span class="flex h-10 items-center">
										<img alt="" width={Math.min(px, 40)} height={Math.min(px, 40)} style={`width:${Math.min(px, 40)}px;height:${Math.min(px, 40)}px`} data-size-img={px} />
									</span>
									<span>{px}px</span>
								</button>
							))}
						</div>
						<p data-note class="mt-3 hidden text-sm text-amber-700 dark:text-amber-400" />

						<div class="mt-5 overflow-hidden rounded-xl border border-slate-200 dark:border-white/10">
							<div class="flex items-center justify-between gap-2 border-b border-slate-200 bg-slate-50 px-2 dark:border-white/10 dark:bg-white/5">
								<div class="flex" role="tablist">
									{(['html', 'markdown', 'url'] as const).map((tab, index) => (
										<button
											type="button"
											role="tab"
											data-tab={tab}
											aria-selected={index === 0 ? 'true' : 'false'}
											class="border-b-2 border-transparent px-3 py-2.5 text-xs font-semibold text-slate-500 hover:text-slate-900 aria-selected:border-brand-500 aria-selected:text-slate-900 dark:text-slate-400 dark:hover:text-white dark:aria-selected:text-white"
										>
											{tab === 'html' ? t.common.html : tab === 'markdown' ? t.common.markdown : t.common.url}
										</button>
									))}
								</div>
								<button
									type="button"
									class="inline-flex items-center gap-1.5 rounded-md px-2 py-1 text-xs font-medium text-slate-500 hover:bg-slate-200/70 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-white/10 dark:hover:text-white"
									data-copy-target={`#lookup-code-${mode}`}
									data-copied-label={t.common.copied}
								>
									<Icon name="copy" class="size-3.5" />
									<span data-copy-label>{t.common.copy}</span>
								</button>
							</div>
							<pre class="overflow-x-auto bg-white p-4 font-mono text-[13px] leading-relaxed text-slate-800 dark:bg-slate-950 dark:text-slate-200"><code id={`lookup-code-${mode}`} data-code /></pre>
						</div>
					</div>
				</div>
			</div>
		)
	}
</div>

<script>
	import { extractHost } from '../lib/host';

	type Messages = { invalid: string; unsupported: string; notFound: string; failed: string; servedFrom: string; sources: Record<string, string> };
	const DOT_COLORS: Record<string, string> = {
		'cache-edge': 'bg-emerald-500',
		'cache-r2': 'bg-emerald-500',
		google: 'bg-sky-500',
		live: 'bg-violet-500',
		default: 'bg-amber-500',
	};

	function looksLikeDomain(host: string): boolean {
		return host.length <= 253 && host.includes('.') && !/[\s<>"'`]/.test(host) && !host.startsWith('.') && !host.includes('..');
	}

	for (const root of document.querySelectorAll<HTMLElement>('[data-lookup]')) {
		const form = root.querySelector('form')!;
		const input = form.querySelector('input')!;
		const errorBox = root.querySelector<HTMLElement>('[data-error]')!;
		const errorText = root.querySelector<HTMLElement>('[data-error-text]')!;
		const result = root.querySelector<HTMLElement>('[data-result]');
		const messages = JSON.parse(root.dataset.i18n ?? '{}') as Messages;
		const base = root.dataset.base ?? location.origin;
		const sitePath = root.dataset.sitePath ?? '/site/{domain}/';
		let current = '';
		let selectedSize = 128;
		let tab: 'html' | 'markdown' | 'url' = 'html';
		let previewUrl = '';

		const showError = (message: string) => {
			errorText.textContent = message;
			errorBox.classList.remove('hidden');
			errorBox.classList.add('flex');
			result?.classList.add('hidden');
		};
		const clearError = () => {
			errorBox.classList.add('hidden');
			errorBox.classList.remove('flex');
		};

		const renderCode = () => {
			if (!result || !current) return;
			const query = selectedSize === 128 ? '' : selectedSize === 256 ? '?larger=true' : `?size=${selectedSize}`;
			const url = `${base}/${current}${query}`;
			const display = Math.min(selectedSize, 64);
			const code = {
				html: `<img src="${url}" width="${display}" height="${display}" alt="${current} favicon">`,
				markdown: `![${current} favicon](${url})`,
				url,
			}[tab];
			result.querySelector('[data-code]')!.textContent = code;
		};

		result?.querySelectorAll<HTMLButtonElement>('[data-size]').forEach((button) => {
			button.addEventListener('click', () => {
				selectedSize = Number(button.dataset.size);
				result.querySelectorAll('[data-size]').forEach((b) => b.setAttribute('aria-checked', String(b === button)));
				renderCode();
			});
		});
		result?.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((button) => {
			button.addEventListener('click', () => {
				tab = button.dataset.tab as typeof tab;
				result.querySelectorAll('[data-tab]').forEach((b) => b.setAttribute('aria-selected', String(b === button)));
				renderCode();
			});
		});

		const lookup = async (raw: string) => {
			const host = extractHost(raw);
			if (!host || !looksLikeDomain(host)) return showError(messages.invalid);
			clearError();

			if (!result) {
				location.href = sitePath.replace('{domain}', encodeURIComponent(host));
				return;
			}

			current = host;
			result.classList.remove('hidden');
			const main = result.querySelector<HTMLImageElement>('[data-main]')!;
			const source = result.querySelector<HTMLElement>('[data-source]')!;
			const dot = result.querySelector<HTMLElement>('[data-dot]')!;
			const note = result.querySelector<HTMLElement>('[data-note]')!;
			main.classList.add('opacity-0');
			result.querySelector('[data-domain]')!.textContent = host;
			result.querySelector<HTMLAnchorElement>('[data-site-link]')!.href = sitePath.replace('{domain}', encodeURIComponent(host));
			source.textContent = '…';
			dot.className = 'size-2 animate-pulse rounded-full bg-slate-300';
			note.classList.add('hidden');
			result.querySelectorAll<HTMLImageElement>('[data-size-img]').forEach((img) => {
				img.src = `/${encodeURIComponent(host)}?size=${img.dataset.sizeImg}`;
				img.alt = `${host} favicon ${img.dataset.sizeImg}px`;
			});
			renderCode();
			try {
				history.replaceState(null, '', `?q=${encodeURIComponent(host)}`);
			} catch {
				// ignore
			}

			try {
				const response = await fetch(`/${encodeURIComponent(host)}?size=128`);
				if (current !== host) return;
				const reason = response.headers.get('x-reason');
				const from = response.headers.get('x-source') ?? 'default';
				if (reason === 'unsupported-tld') return showError(messages.unsupported.replace('{tld}', host.split('.').pop() ?? ''));
				if (reason === 'invalid-domain') return showError(messages.invalid);
				if (previewUrl) URL.revokeObjectURL(previewUrl);
				previewUrl = URL.createObjectURL(await response.blob());
				main.src = previewUrl;
				main.alt = `${host} favicon`;
				main.classList.remove('opacity-0');
				source.textContent = `${messages.servedFrom}: ${messages.sources[from] ?? from}`;
				dot.className = `size-2 rounded-full ${DOT_COLORS[from] ?? 'bg-slate-400'}`;
				if (from === 'default') {
					note.textContent = messages.notFound;
					note.classList.remove('hidden');
				}
			} catch {
				source.textContent = messages.failed;
				dot.className = 'size-2 rounded-full bg-rose-500';
			}
		};

		form.addEventListener('submit', (event) => {
			event.preventDefault();
			void lookup(input.value);
		});

		if (result) {
			const initial = new URLSearchParams(location.search).get('q');
			if (initial) {
				input.value = initial;
				void lookup(initial);
			}
		}
	}
</script>
