---
import Icon from './Icon.astro';
import { localizePath, useTranslations, type Locale } from '../i18n';
import type { Crumb } from '../layouts/BaseLayout.astro';

interface Props {
	locale: Locale;
	items: Crumb[];
}

const { locale, items } = Astro.props;
const t = useTranslations(locale);
const trail = [{ name: t.common.home, path: '/' }, ...items];
---

<nav aria-label="Breadcrumb" class="text-sm">
	<ol class="flex flex-wrap items-center gap-1.5 text-slate-500 dark:text-slate-400">
		{
			trail.map((crumb, index) => (
				<li class="flex items-center gap-1.5">
					{index > 0 && <Icon name="chevronRight" class="size-3.5 text-slate-400 dark:text-slate-600" />}
					{index < trail.length - 1 ? (
						<a href={localizePath(locale, crumb.path)} class="hover:text-slate-900 dark:hover:text-white">
							{crumb.name}
						</a>
					) : (
						<span class="font-medium text-slate-700 dark:text-slate-200" aria-current="page">
							{crumb.name}
						</span>
					)}
				</li>
			))
		}
	</ol>
</nav>
