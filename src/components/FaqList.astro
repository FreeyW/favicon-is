---
import Icon from './Icon.astro';

interface Props {
	items: { q: string; a: string[] }[];
}
const { items } = Astro.props;
---

<div class="divide-y divide-slate-200 overflow-hidden rounded-2xl border border-slate-200 bg-white dark:divide-white/10 dark:border-white/10 dark:bg-slate-900/60">
	{
		items.map((item) => (
			<details class="group">
				<summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-left font-semibold text-slate-900 hover:bg-slate-50 sm:px-6 dark:text-white dark:hover:bg-white/5">
					<h3 class="text-base">{item.q}</h3>
					<Icon name="chevronDown" class="size-5 shrink-0 text-slate-400 transition group-open:rotate-180" />
				</summary>
				<div class="space-y-3 px-5 pb-5 leading-relaxed text-slate-600 sm:px-6 dark:text-slate-400">
					{item.a.map((paragraph) => (
						<p>{paragraph}</p>
					))}
				</div>
			</details>
		))
	}
</div>
