---
import { LOCALES, LOCALE_CODES, fmt, localizePath, useTranslations, type Locale } from '../i18n';
import { PRODUCTS } from '../site.config';

interface Props {
	locale: Locale;
	path: string;
}

const { locale, path } = Astro.props;
const t = useTranslations(locale);
const l = (p: string) => localizePath(locale, p);
const columns = [
	{
		title: t.footer.product,
		links: [
			{ href: '/', label: t.nav.home },
			{ href: '/docs/', label: t.nav.docs },
			{ href: '/examples/', label: t.nav.examples },
			{ href: '/checker/', label: t.nav.checker },
		],
	},
	{
		title: t.footer.resources,
		links: [
			{ href: '/popular/', label: t.nav.popular },
			{ href: '/tlds/', label: t.nav.tlds },
			{ href: '/guides/', label: t.nav.guides },
			{ href: '/faq/', label: t.nav.faq },
		],
	},
	{
		title: t.footer.company,
		links: [
			{ href: '/about/', label: t.nav.about },
			{ href: '/privacy/', label: t.nav.privacy },
			{ href: '/terms/', label: t.nav.terms },
		],
	},
];
const year = new Date().getUTCFullYear();
---

<footer class="mt-24 border-t border-slate-200 bg-slate-50/70 dark:border-white/10 dark:bg-slate-900/40">
	<div class="container-page py-14">
		<div class="grid gap-10 lg:grid-cols-12">
			<div class="lg:col-span-3">
				<a href={l('/')} class="flex items-center gap-2.5 font-bold text-slate-900 dark:text-white">
					<img src="/favicon.png" alt="" width="32" height="32" class="size-8 rounded-lg" loading="lazy" />
					<span class="text-lg">Favicon<span class="text-brand-600 dark:text-brand-400">.is</span></span>
				</a>
				<p class="mt-4 max-w-sm text-sm leading-relaxed text-slate-600 dark:text-slate-400">{t.footer.description}</p>
			</div>
			<div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:col-span-4">
				{
					columns.map((column) => (
						<div>
							<h2 class="text-sm font-semibold">{column.title}</h2>
							<ul class="mt-3 space-y-2.5 text-sm">
								{column.links.map((link) => (
									<li>
										<a href={l(link.href)} class="text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white">
											{link.label}
										</a>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
			<div class="lg:col-span-5">
				<h2 class="text-sm font-semibold">{t.footer.moreTools}</h2>
				<ul class="mt-3 grid grid-cols-1 gap-x-4 gap-y-2.5 text-sm sm:grid-cols-2">
					{
						PRODUCTS.map((product) => (
							<li>
								<a href={product.url} class="group flex items-start gap-2" title={t.footer.products[product.key]} rel="noopener">
									<img src={`/${product.icon}?size=32`} alt="" width="16" height="16" class="mt-0.5 size-4 shrink-0 rounded" loading="lazy" />
									<span class="min-w-0">
										<span class="font-medium text-slate-800 group-hover:text-brand-600 dark:text-slate-200 dark:group-hover:text-brand-400">{product.name}</span>
										<span class="block truncate text-xs text-slate-500 dark:text-slate-500">{t.footer.products[product.key]}</span>
									</span>
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>

		<nav class="mt-12 flex flex-wrap gap-x-4 gap-y-2 border-t border-slate-200 pt-6 text-xs dark:border-white/10" aria-label={t.nav.language}>
			{
				LOCALE_CODES.map((code) => (
					<a
						href={localizePath(code, path)}
						hreflang={LOCALES[code].hreflang}
						lang={LOCALES[code].htmlLang}
						class:list={[code === locale ? 'font-semibold text-slate-900 dark:text-white' : 'text-slate-500 hover:text-slate-900 dark:hover:text-white']}
					>
						{LOCALES[code].name}
					</a>
				))
			}
		</nav>
		<div class="mt-4 flex flex-col gap-2 text-xs text-slate-500 sm:flex-row sm:justify-between">
			<p>{fmt(t.footer.rights, { year })}</p>
			<p>{t.footer.inspired}</p>
		</div>
	</div>
</footer>
