---
/** Unhighlighted code block with a copy button (safe for on-demand pages). */
import Icon from './Icon.astro';

interface Props {
	code: string;
	title: string;
	copyLabel: string;
	copiedLabel: string;
	id?: string;
}

const { code, title, copyLabel, copiedLabel, id } = Astro.props;
---

<div class="overflow-hidden rounded-xl border border-slate-200 bg-slate-50 dark:border-white/10 dark:bg-slate-900">
	<div class="flex items-center justify-between gap-3 border-b border-slate-200 px-4 py-2 dark:border-white/10">
		<span class="text-xs font-medium text-slate-500 dark:text-slate-400">{title}</span>
		<button
			type="button"
			class="inline-flex items-center gap-1.5 rounded-md px-2 py-1 text-xs font-medium text-slate-500 transition hover:bg-slate-200/70 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-white/10 dark:hover:text-white"
			data-copy={code}
			data-copied-label={copiedLabel}
		>
			<Icon name="copy" class="size-3.5" />
			<span data-copy-label>{copyLabel}</span>
		</button>
	</div>
	<pre class="overflow-x-auto p-4 font-mono text-[13px] leading-relaxed text-slate-800 dark:text-slate-200" id={id}><code>{code}</code></pre>
</div>
