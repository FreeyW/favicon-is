---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { LOCALES, LOCALE_CODES, DEFAULT_LOCALE, absoluteUrl, localizePath, useTranslations, type Locale } from '../i18n';
import { ADSENSE_CLIENT, ANALYTICS_DOMAIN, ANALYTICS_SRC, SITE_NAME, SITE_URL } from '../site.config';

export interface Crumb {
	name: string;
	/** Unlocalised path, e.g. `/guides/`. */
	path: string;
}

interface Props {
	locale: Locale;
	/** Full document title. */
	title: string;
	description: string;
	/** Unlocalised path of this page, e.g. `/docs/`. */
	path: string;
	noindex?: boolean;
	ogType?: 'website' | 'article';
	ogImage?: string;
	/** Extra JSON-LD nodes merged into the page graph. */
	jsonLd?: Record<string, unknown>[];
	/** Breadcrumb trail after "Home" (used for BreadcrumbList structured data). */
	breadcrumbs?: Crumb[];
	/** Set to false for pages that only exist in one language. */
	alternates?: boolean;
}

const {
	locale,
	title,
	description,
	path,
	noindex = false,
	ogType = 'website',
	ogImage = '/og-image.png',
	jsonLd = [],
	breadcrumbs,
	alternates = true,
} = Astro.props;

const t = useTranslations(locale);
const info = LOCALES[locale];
const canonical = absoluteUrl(localizePath(locale, path));
const alternateLinks = alternates
	? LOCALE_CODES.map((code) => ({ hreflang: LOCALES[code].hreflang, href: absoluteUrl(localizePath(code, path)) }))
	: [];
const ogImageUrl = absoluteUrl(ogImage);

const organization = {
	'@type': 'Organization',
	'@id': `${SITE_URL}/#organization`,
	name: SITE_NAME,
	url: `${SITE_URL}/`,
	logo: { '@type': 'ImageObject', url: `${SITE_URL}/favicon.png`, width: 256, height: 256 },
};
const website = {
	'@type': 'WebSite',
	'@id': `${SITE_URL}/#website`,
	url: `${SITE_URL}/`,
	name: SITE_NAME,
	description: t.footer.description,
	publisher: { '@id': `${SITE_URL}/#organization` },
	inLanguage: LOCALE_CODES.map((code) => LOCALES[code].htmlLang),
};
const webpage = {
	'@type': 'WebPage',
	'@id': `${canonical}#webpage`,
	url: canonical,
	name: title,
	description,
	inLanguage: info.htmlLang,
	isPartOf: { '@id': `${SITE_URL}/#website` },
	...(breadcrumbs?.length ? { breadcrumb: { '@id': `${canonical}#breadcrumb` } } : {}),
};
const breadcrumbList = breadcrumbs?.length
	? {
			'@type': 'BreadcrumbList',
			'@id': `${canonical}#breadcrumb`,
			itemListElement: [{ name: t.common.home, path: '/' }, ...breadcrumbs].map((crumb, index) => ({
				'@type': 'ListItem',
				position: index + 1,
				name: crumb.name,
				item: absoluteUrl(localizePath(locale, crumb.path)),
			})),
		}
	: null;

const graph = {
	'@context': 'https://schema.org',
	'@graph': [organization, website, webpage, ...(breadcrumbList ? [breadcrumbList] : []), ...jsonLd],
};
---

<!doctype html>
<html lang={info.htmlLang} dir={info.dir}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
		{alternateLinks.map((link) => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}
		{alternates && <link rel="alternate" hreflang="x-default" href={absoluteUrl(localizePath(DEFAULT_LOCALE, path))} />}

		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={t.meta.ogImageAlt} />
		<meta property="og:locale" content={info.og} />
		{alternates && LOCALE_CODES.filter((code) => code !== locale).map((code) => <meta property="og:locale:alternate" content={LOCALES[code].og} />)}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.png" type="image/png" sizes="256x256" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#020617" media="(prefers-color-scheme: dark)" />
		<meta name="generator" content={Astro.generator} />
		<link rel="sitemap" href="/sitemap.xml" />

		<script is:inline>
			try {
				const stored = localStorage.getItem('theme');
				if (stored === 'dark' || (!stored && matchMedia('(prefers-color-scheme: dark)').matches)) {
					document.documentElement.classList.add('dark');
				}
			} catch {}
		</script>
		<script type="application/ld+json" set:html={JSON.stringify(graph)} />
		{ANALYTICS_SRC && <script is:inline defer data-domain={ANALYTICS_DOMAIN} src={ANALYTICS_SRC} />}
		{
			ADSENSE_CLIENT && (
				<script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`} crossorigin="anonymous" />
			)
		}
		<slot name="head" />
	</head>
	<body class="flex min-h-screen flex-col">
		<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:shadow-lg dark:focus:bg-slate-900">
			{t.nav.skipToContent}
		</a>
		<Header locale={locale} path={path} />
		<main id="main" class="flex-1">
			<slot />
		</main>
		<Footer locale={locale} path={path} />

		<script>
			// Copy-to-clipboard for any element with data-copy (text) or data-copy-target (selector).
			document.addEventListener('click', async (event) => {
				const button = (event.target as Element | null)?.closest<HTMLElement>('[data-copy], [data-copy-target]');
				if (!button) return;
				const target = button.dataset.copyTarget ? document.querySelector(button.dataset.copyTarget) : null;
				const text = button.dataset.copy ?? target?.textContent ?? '';
				try {
					await navigator.clipboard.writeText(text.trim());
				} catch {
					return;
				}
				const label = button.querySelector<HTMLElement>('[data-copy-label]');
				if (label) {
					const original = label.textContent;
					label.textContent = button.dataset.copiedLabel ?? '✓';
					button.classList.add('text-emerald-600', 'dark:text-emerald-400');
					setTimeout(() => {
						label.textContent = original;
						button.classList.remove('text-emerald-600', 'dark:text-emerald-400');
					}, 1600);
				}
			});
		</script>
	</body>
</html>
