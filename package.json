{
  "name": "favicon-is",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check:locales": "node scripts/check-frontmatter.mjs && node scripts/check-locales.mjs",
    "preview": "astro build && wrangler dev",
    "check": "wrangler types && astro check",
    "deploy": "astro build && wrangler deploy",
    "update:tlds": "node scripts/update-tlds.mjs",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "global-tld-list": "^1.30.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.166.0"
  },
  "description": "Free favicon API – get any website’s icon with one URL. Astro + TypeScript on Cloudflare Workers with R2 storage.",
  "engines": {
    "node": ">=22.18"
  }
