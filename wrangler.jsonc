{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "favicon-is",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-11-17",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "none"
	},
	// Favicon storage. Create it once with: npx wrangler r2 bucket create favicon-is
	"r2_buckets": [
		{
			"binding": "FAVICONS",
			"bucket_name": "favicon-is"
		}
	],
	// Per-IP limit for the JSON inspect API used by the favicon checker page.
	"ratelimits": [
		{
			"name": "INSPECT_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 30, "period": 60 }
		}
	],
	"vars": {
		// How long a stored favicon is served before it is refreshed in the background (seconds).
		"ICON_TTL": "604800",
		// How long a failed lookup is remembered before it is retried (seconds).
		"FAILURE_TTL": "3600"
	},
	"observability": { "enabled": true },
	// Uncomment to attach the Worker to the production domain.
	// "routes": [
	// 	{ "pattern": "favicon.is", "custom_domain": true },
	// 	{ "pattern": "www.favicon.is", "custom_domain": true }
	// ],
}
